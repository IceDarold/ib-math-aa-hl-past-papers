        "solve_linear_equation",
        "expected_value_formula"
      ],
      "method_path": [
        "List outcomes X<Y: (1,2),(1,3),(1,4),(2,3),(2,4),(3,4)",
        "P(X<Y) = 3pq + 3pr = 3p(q+r)",
        "Substitute p=2/7: (6/7)(q+r) = 1/2",
        "Use r=1-3q: (6/7)(1-2q) = 1/2",
        "Solve: q=5/24, r=3/8",
