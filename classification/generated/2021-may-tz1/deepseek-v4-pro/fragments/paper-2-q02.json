      "markscheme_pages": "9",
      "task_summary": "Given a bag is not rejected, find the probability its mass exceeds 1005 g, i.e. P(X > 1005 | X ≥ 995).",
      "primary_topic": "statistics.continuous_random_variables",
      "secondary_topics": [
        "statistics.probability"
      ],
      "method_family": "probability_and_distributions",
      "method_tags": [
        "conditional_probability",
        "normal_distribution",
        "symmetry",
        "probability_calculation"
      ],
      "method_path": [
        "Recognize conditional probability P(X > 1005 | X ≥ 995) is required",
        "Express as P(X > 1005) / P(X ≥ 995)",
        "Use symmetry: P(X > 1005) = P(X < 995) = 0.07656…",
        "Compute 0.07656… / (1 − 0.07656…) = 0.07656… / 0.9234…",
        "Obtain 0.0829"
      ],
