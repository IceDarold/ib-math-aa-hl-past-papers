      "markscheme_pages": "16",
      "task_summary": "Given 80% of apples are eating apples, both types are mixed and those weighing >140 g are separated. Find the probability a randomly selected apple from the >140 g container is an eating apple. Answer as c/d with c, d ∈ ℤ⁺.",
      "primary_topic": "statistics.probability",
      "secondary_topics": [
        "statistics.continuous_random_variables"
      ],
      "method_family": "probability_and_distributions",
      "method_tags": [
        "conditional_probability",
        "normal_distribution",
        "law_of_total_probability",
        "bayes_theorem"
      ],
      "method_path": [
        "P(cooking > 140) = 0.5 (symmetric about mean 140)",
        "P(eating > 140) = 0.025 (from part a)",
        "apply conditional probability: P(eating | >140) = P(eating ∩ >140) / P(>140)",
        "P(eating ∩ >140) = 0.8 × 0.025 = 0.02",
        "P(>140) = 0.8 × 0.025 + 0.2 × 0.5 = 0.12",
        "result = 0.02 / 0.12 = 1/6"
      ],
